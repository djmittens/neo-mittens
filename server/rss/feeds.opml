<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>obelisk yarr feeds</title>
  </head>
  <body>
    <outline text="Tech News" title="Tech News">
      <outline type="rss" text="Hacker News" title="Hacker News" xmlUrl="https://news.ycombinator.com/rss" htmlUrl="https://news.ycombinator.com"/>
      <outline type="rss" text="Hacker News (200+ points)" title="Hacker News (200+ points)" xmlUrl="https://hnrss.org/frontpage?points=200" htmlUrl="https://news.ycombinator.com"/>
      <outline type="rss" text="Ars Technica" title="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index" htmlUrl="https://arstechnica.com"/>
      <outline type="rss" text="The Verge" title="The Verge" xmlUrl="https://www.theverge.com/rss/index.xml" htmlUrl="https://www.theverge.com"/>
      <outline type="rss" text="404 Media" title="404 Media" xmlUrl="https://www.404media.co/rss/" htmlUrl="https://www.404media.co"/>
    </outline>
    <outline text="Programming" title="Programming">
      <outline type="rss" text="Lobsters" title="Lobsters" xmlUrl="https://lobste.rs/rss" htmlUrl="https://lobste.rs"/>
      <outline type="rss" text="Julia Evans (b0rk)" title="Julia Evans (b0rk)" xmlUrl="https://jvns.ca/atom.xml" htmlUrl="https://jvns.ca"/>
      <outline type="rss" text="Dan Luu" title="Dan Luu" xmlUrl="https://danluu.com/atom.xml" htmlUrl="https://danluu.com"/>
      <outline type="rss" text="Fabien Sanglard" title="Fabien Sanglard" xmlUrl="https://fabiensanglard.net/rss.xml" htmlUrl="https://fabiensanglard.net"/>
    </outline>
    <outline text="Hands-On / Hardware" title="Hands-On / Hardware">
      <outline type="rss" text="Hackaday" title="Hackaday" xmlUrl="https://hackaday.com/feed/" htmlUrl="https://hackaday.com"/>
      <outline type="rss" text="Adafruit Blog" title="Adafruit Blog" xmlUrl="https://blog.adafruit.com/feed/" htmlUrl="https://blog.adafruit.com"/>
    </outline>
    <outline text="News" title="News">
      <!-- Paywalled news. Subscribe these via the rss-proxy /feed wrapper
           (https://<host>:7071/feed?url=<URL-encoded feed below>) like Hacker News, so each
           article link routes through /article (Camoufox paywall tier). The xmlUrls here are
           the originals (portable); the proxy wrapper is host-specific.
           Per-site reality (see server/rssproxy/README.md):
             NYT       -> FULL article (nyt.go extracts window.__preloadedData).
             Economist -> partial teaser (server-rendered free portion).
             WSJ       -> headline/summary only (hard wall + datacenter-IP bot block).
             Bloomberg -> headline/summary only (client-rendered + bot detection). -->
      <outline type="rss" text="NYT Home Page" title="NYT Home Page" xmlUrl="https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml" htmlUrl="https://www.nytimes.com"/>
      <outline type="rss" text="NYT World" title="NYT World" xmlUrl="https://rss.nytimes.com/services/xml/rss/nyt/World.xml" htmlUrl="https://www.nytimes.com/section/world"/>
      <outline type="rss" text="NYT Technology" title="NYT Technology" xmlUrl="https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml" htmlUrl="https://www.nytimes.com/section/technology"/>
      <outline type="rss" text="NYT Science" title="NYT Science" xmlUrl="https://rss.nytimes.com/services/xml/rss/nyt/Science.xml" htmlUrl="https://www.nytimes.com/section/science"/>
      <outline type="rss" text="NYT Most Popular" title="NYT Most Popular" xmlUrl="https://rss.nytimes.com/services/xml/rss/nyt/MostViewed.xml" htmlUrl="https://www.nytimes.com/trending"/>
      <outline type="rss" text="WSJ World News" title="WSJ World News" xmlUrl="https://feeds.a.dj.com/rss/RSSWorldNews.xml" htmlUrl="https://www.wsj.com/news/world"/>
      <outline type="rss" text="WSJ Technology" title="WSJ Technology" xmlUrl="https://feeds.a.dj.com/rss/RSSWSJD.xml" htmlUrl="https://www.wsj.com/news/technology"/>
      <outline type="rss" text="The Economist Latest" title="The Economist Latest" xmlUrl="https://www.economist.com/latest/rss.xml" htmlUrl="https://www.economist.com/latest"/>
      <outline type="rss" text="The Economist Science &amp; Tech" title="The Economist Science &amp; Tech" xmlUrl="https://www.economist.com/science-and-technology/rss.xml" htmlUrl="https://www.economist.com/science-and-technology"/>
      <outline type="rss" text="Bloomberg Technology" title="Bloomberg Technology" xmlUrl="https://feeds.bloomberg.com/technology/news.rss" htmlUrl="https://www.bloomberg.com/technology"/>
      <outline type="rss" text="Bloomberg Markets" title="Bloomberg Markets" xmlUrl="https://feeds.bloomberg.com/markets/news.rss" htmlUrl="https://www.bloomberg.com/markets"/>
    </outline>
    <outline text="Math" title="Math">
      <outline type="rss" text="Quanta Magazine" title="Quanta Magazine" xmlUrl="https://api.quantamagazine.org/feed/" htmlUrl="https://www.quantamagazine.org"/>
      <outline type="rss" text="John D. Cook" title="John D. Cook" xmlUrl="https://www.johndcook.com/blog/feed/" htmlUrl="https://www.johndcook.com/blog"/>
      <outline type="rss" text="Terence Tao" title="Terence Tao" xmlUrl="https://terrytao.wordpress.com/feed/" htmlUrl="https://terrytao.wordpress.com"/>
    </outline>
    <outline text="Games / Graphics" title="Games / Graphics">
      <outline type="rss" text="The ryg blog (Fabian Giesen)" title="The ryg blog (Fabian Giesen)" xmlUrl="https://fgiesen.wordpress.com/feed/" htmlUrl="https://fgiesen.wordpress.com"/>
      <outline type="rss" text="Bartosz Ciechanowski" title="Bartosz Ciechanowski" xmlUrl="https://ciechanow.ski/atom.xml" htmlUrl="https://ciechanow.ski"/>
      <outline type="rss" text="GameDev.net" title="GameDev.net" xmlUrl="https://www.gamedev.net/rss/news/" htmlUrl="https://www.gamedev.net"/>
      <!-- Inigo Quilez has no native RSS feed (iquilezles.org/rss.xml is 404).
           Subscribed in yarr via rss-proxy /htmlfeed scraping iquilezles.org/articles/
           (see server/rssproxy/README.md). Not a portable feed URL, so not listed here. -->
      <!-- Removed: r/GraphicsProgramming (Reddit 403s server/datacenter IPs like obelisk) -->
    </outline>
  </body>
</opml>
