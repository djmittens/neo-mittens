[Unit]
Description=rss-proxy (on-demand full-text RSS proxy for yarr)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h

# Listen on loopback; exposure to the tailnet is via `tailscale serve` (set up by install.sh).
Environment="RSSPROXY_ADDR=127.0.0.1:7071"
# Public base = the tailnet HTTPS URL of THIS proxy. install.sh substitutes the real
# MagicDNS hostname here. yarr must reach the proxy by hostname (passes its SSRF guard),
# and your browser loads /img from here, so it must be the tailnet URL, not localhost.
Environment="RSSPROXY_PUBLIC_BASE=__PUBLIC_BASE__"
Environment="RSSPROXY_CACHE=%h/.local/share/rssproxy/cache.db"
Environment="RSSPROXY_TTL_HOURS=720"
# Browser tier for JS-rendered pages (e.g. BBC). Preferred: the Camoufox sidecar
# (anti-fingerprint Firefox in a rootless-podman container - see camoufox/).
Environment="RSSPROXY_RENDER_URL=http://127.0.0.1:7072/render"
# Fallback browser tier: in-process headless Chromium via chromedp.
Environment="RSSPROXY_CHROME=/usr/bin/chromium"
# Domains that must always be rendered in the browser (JS-SPA sites with no static body).
Environment="RSSPROXY_RENDER_HOSTS=bbc.co.uk,bbc.com"
# Metered/paywalled news sites: rendered in the browser with JavaScript DISABLED so the
# server-rendered article body comes back without the JS-injected meter/overlay
# (removepaywalls.com-style bypass). Empty string here = use the binary's built-in default
# list (nytimes.com, wsj.com, washingtonpost.com, economist.com, ft.com, ...). Set a value
# to override that list entirely.
Environment="RSSPROXY_PAYWALL_HOSTS="
# Optional User-Agent for paywall-bypass renders (e.g. a Googlebot string). Empty keeps the
# anti-fingerprint browser's own UA, which is usually more robust than spoofing Googlebot
# from a non-Google IP.
Environment="RSSPROXY_PAYWALL_UA="
# Domains to force onto chromedp instead of Camoufox (empty: Camoufox handles all rendering;
# chromedp is just the fallback if the sidecar is down). A per-site escape hatch.
Environment="RSSPROXY_CHROMEDP_HOSTS="
# Optional alternative browser tier (FlareSolverr HTTP API). Leave empty if using chromium.
Environment="RSSPROXY_FLARESOLVERR="

ExecStart=%h/.local/bin/rss-proxy

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rss-proxy

[Install]
WantedBy=default.target
