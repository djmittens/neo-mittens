[Unit]
Description=rss-proxy Camoufox render sidecar (rootless podman)
After=network-online.target
Wants=network-online.target

[Service]
# Run the prebuilt image (see install.sh) as a rootless container, foregrounded so
# systemd supervises it. Publishes only on loopback; the rss-proxy calls it locally.
#
# CAMOUFOX_HEADLESS=virtual runs a real headed Firefox on an internal Xvfb display, which
# Camoufox recommends over true headless (headless leaks bot signals). CAMOUFOX_HUMANIZE=1
# adds human-like cursor motion. These minimise *fingerprint* detection; they do NOT solve a
# CAPTCHA that a behavioural anti-bot (DataDome/PerimeterX, e.g. WSJ/Bloomberg) chooses to
# present. Set CAMOUFOX_HEADLESS=1 to fall back to true headless (faster, more detectable).
# CAMOUFOX_GEOIP=0: geoip coherence broke NYT's JS-off path without unlocking the hard sites
# (the warm-up flow handles those); set =1 to experiment (the [geoip] extra is in the image).
#
# Secrets/config for the hard sites live in an OPTIONAL env file (not committed):
#   ~/.config/rss-camoufox/env   with lines like
#     CAPSOLVER_KEY=CAP-XXXXXXXX          # enables automatic DataDome solving
#     CAMOUFOX_PROXY=http://user:pass@host:port   # REQUIRED for DataDome (IP-bound cookie)
# and a cookie jar (subscriber/clearance cookies, Playwright JSON) at
#   ~/.config/rss-camoufox/cookies.json  (mounted read-only at /cookies).
EnvironmentFile=-%h/.config/rss-camoufox/env
ExecStartPre=-/usr/bin/podman rm -f rss-camoufox
ExecStart=/usr/bin/podman run --rm --name rss-camoufox -p 127.0.0.1:7072:7072 \
  -e CAMOUFOX_HEADLESS=virtual -e CAMOUFOX_HUMANIZE=1 -e CAMOUFOX_GEOIP=0 \
  -e COOKIES_FILE=/cookies/cookies.json -e CAPSOLVER_KEY -e CAPSOLVER_URL -e CAMOUFOX_PROXY \
  -v %h/.config/rss-camoufox:/cookies:ro localhost/rss-camoufox:latest
ExecStop=/usr/bin/podman stop -t 5 rss-camoufox
Restart=on-failure
RestartSec=10
# Camoufox/Firefox can spike memory; give it room but cap it.
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rss-camoufox

[Install]
WantedBy=default.target
